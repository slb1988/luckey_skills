# pdf-translate skill 凭据模板
# 实际值写入 ObsidianVault 仓库根目录的 .env（已被 .gitignore 忽略），本模板入库

# build-api-proxy 网关 OpenAI 兼容端点（网关细节见 build-api-proxy skill）
OPENAILIKED_BASE_URL=http://<网关地址>/v1
# 网关虚拟 key
OPENAILIKED_API_KEY=<your-gateway-key>
# 模型：kimi-k3（推理，质量好）或 deepseek-v4-flash（快、便宜、免 temperature 补丁）
OPENAILIKED_MODEL=kimi-k3
# kimi-k3 上游强制 temperature=1，必须设；用 deepseek-v4-flash 时删除本行
PDF2ZH_OPENAI_TEMPERATURE=1
